#!/bin/sh
# Block commits containing anything that looks like a secret.
#
# Installed via:  git config core.hooksPath .githooks
# Requires:       winget install --id Gitleaks.Gitleaks -e
#
# History: five API keys (probullstats, Supabase, FRED, EIA, BEA) were committed
# in plaintext across this account's repos before this hook existed. That is what
# this prevents. It FAILS CLOSED - if the scanner is missing, the commit is
# blocked rather than silently unscanned.

find_gitleaks() {
  if command -v gitleaks >/dev/null 2>&1; then
    command -v gitleaks
    return 0
  fi
  # winget shim directory
  if [ -x "$LOCALAPPDATA/Microsoft/WinGet/Links/gitleaks.exe" ]; then
    echo "$LOCALAPPDATA/Microsoft/WinGet/Links/gitleaks.exe"
    return 0
  fi
  # winget package directory (version-suffixed, so glob it)
  for c in "$LOCALAPPDATA"/Microsoft/WinGet/Packages/Gitleaks.Gitleaks_*/gitleaks.exe; do
    [ -x "$c" ] && { echo "$c"; return 0; }
  done
  # chocolatey / manual installs
  for c in "/c/ProgramData/chocolatey/bin/gitleaks.exe" "/c/Program Files/gitleaks/gitleaks.exe"; do
    [ -x "$c" ] && { echo "$c"; return 0; }
  done
  return 1
}

GITLEAKS=$(find_gitleaks)

if [ -z "$GITLEAKS" ]; then
  echo ""
  echo "  COMMIT BLOCKED - the secret scanner is not installed."
  echo ""
  echo "    winget install --id Gitleaks.Gitleaks -e"
  echo ""
  echo "  This hook fails closed on purpose: an unscanned commit is how five"
  echo "  API keys ended up in git history. Install it, then commit again."
  echo ""
  exit 1
fi

# gitleaks 8.30 removed `protect`; the staged scan now lives under `git`.
"$GITLEAKS" git --staged --redact --no-banner .
STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo ""
  echo "  COMMIT BLOCKED - a possible secret was found in your staged changes."
  echo ""
  echo "  Fix it, don't bypass it:"
  echo "    1. Move the value into .env (and confirm .env is gitignored)"
  echo "    2. Read it with os.getenv(\"NAME\")"
  echo "    3. Re-stage and commit again"
  echo ""
  echo "  If it is definitely a false positive, add it to .gitleaksignore with a"
  echo "  comment explaining why. Do NOT use --no-verify."
  echo ""
  exit 1
fi

exit 0
